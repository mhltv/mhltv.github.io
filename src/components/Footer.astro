---
import { siteInfo } from '../config';
const year = new Date().getFullYear();
---
<footer class="border-t border-paper-deep">
  <div class="huwen mx-auto max-w-7xl" style="max-width:none"></div>
  <div class="mx-auto max-w-7xl px-4 py-10 text-center sm:px-6">
    <p class="text-sm text-ink-soft">
      Made By 录人&amp;刘亦菲的影迷朋友们 ❤️
    </p>
    <p class="mt-2 text-sm text-ink-faint">
      Copyright © 2023–{year} · <a href={siteInfo.feedbackUrl} class="underline underline-offset-4 hover:text-cinnabar">意见反馈</a>
    </p>
  </div>
</footer>
