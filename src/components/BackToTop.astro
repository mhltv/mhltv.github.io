<button
  id="back-to-top"
  class="fixed bottom-6 right-6 hidden h-11 w-11 items-center justify-center rounded-full border border-paper-deep bg-paper-card text-cinnabar shadow-lg transition-all hover:bg-paper-deep"
  aria-label="回到顶部"
>
  ↑
</button>

<script>
  const btn = document.getElementById('back-to-top');
  function toggle() {
    if (!btn) return;
    const show = window.scrollY > 400;
    btn.classList.toggle('hidden', !show);
    btn.classList.toggle('flex', show);
  }
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
