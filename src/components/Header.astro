---
import { sections } from '../config';
import SealLogo from './SealLogo.astro';
import SearchModal from './SearchModal.astro';

const path = Astro.url.pathname;

function isActive(folder: string) {
  return path === `/${folder}/` || path.startsWith(`/${folder}/`);
}
---
<header class="sticky top-0 z-40 border-b border-paper-deep bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-3">
      <SealLogo size={40} />
      <span class="font-song text-xl font-bold tracking-[0.25em] text-ink">梦华录</span>
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-0.5 lg:flex">
      {sections.map((s) => (
        <a
          href={`/${s.folder}/`}
          class:list={[
            'rounded px-3 py-2 text-[15px] tracking-wide transition-colors',
            isActive(s.folder)
              ? 'font-bold text-cinnabar'
              : 'text-ink-soft hover:bg-paper-deep hover:text-ink',
          ]}
        >
          {s.navTitle}
        </a>
      ))}
    </nav>

    <div class="ml-auto lg:ml-0">
      <SearchModal />
    </div>
  </div>

  <details class="border-t border-paper-deep lg:hidden">
    <summary class="flex cursor-pointer select-none items-center justify-center gap-2 py-2.5 text-sm text-ink-soft">
      栏目目录
    </summary>
    <nav class="grid grid-cols-5 gap-1 px-4 pb-3">
      {sections.map((s) => (
        <a
          href={`/${s.folder}/`}
          class:list={[
            'rounded py-1.5 text-center text-sm transition-colors',
            isActive(s.folder) ? 'font-bold text-cinnabar' : 'text-ink-soft',
          ]}
        >
          {s.navTitle}
        </a>
      ))}
    </nav>
  </details>
</header>
